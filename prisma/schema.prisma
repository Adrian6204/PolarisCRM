// Polaris CRM — Prisma schema
//
// Serverless note: the app connects through DATABASE_URL (a pooled connection,
// e.g. Neon/Supabase pooler or PgBouncer). Migrations run through DIRECT_URL
// (a non-pooled connection) because DDL over a transaction pooler is unsafe.
//
// Feature models (Client, Contact, Project, ...) are added in their own phases
// per the build order. Phase 0 defines only the auth/identity models that the
// infra (NextAuth role-based sessions) needs to exist.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Identity / Auth (Phase 0) --------------------------------------------

enum Role {
  admin
  project_lead
  team_member
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // Null for SSO-only accounts; set for credentials login (hashed).
  passwordHash String?  @map("password_hash")
  role         Role     @default(team_member)
  // Deactivated users keep their history but cannot sign in.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedDeliverables Deliverable[]
  activities        Activity[]
  auditLogs         AuditLog[]
  ownedDeals        Deal[]
  notes             Note[]
  appointments      Appointment[]
  availabilityRules AvailabilityRule[]
  notifications     Notification[]
  attachments       Attachment[]

  @@index([role])
  @@map("users")
}

// In-app notification for a user (reminders, nudges). `dedupeKey` makes
// reminder generation idempotent so a scan won't create duplicates.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  href      String?
  dedupeKey String?   @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// --- Clients & Contacts (Phase 1) -----------------------------------------

enum ClientStatus {
  active
  past
  prospect
}

enum ContactRole {
  decision_maker
  technical_poc
  billing
  other
}

model Client {
  id        String       @id @default(cuid())
  name      String
  industry  String?
  website   String?
  status    ClientStatus @default(prospect)
  // Soft delete — an agency CRM where records vanish is a support headache.
  // All app-level reads must filter `deletedAt: null`; see clientService.
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  contacts     Contact[]
  projects     Project[]
  activities   Activity[]
  auditLogs    AuditLog[]
  deals        Deal[]
  notes        Note[]
  tags         ClientTag[]
  customFields ClientCustomField[]
  appointments Appointment[]
  attachments  Attachment[]

  // status is frequently filtered in list views; deletedAt gates every read.
  @@index([status])
  @@index([deletedAt])
  @@map("clients")
}

model Contact {
  id        String      @id @default(cuid())
  clientId  String      @map("client_id")
  name      String
  email     String
  phone     String?
  role      ContactRole @default(other)
  isPrimary Boolean     @default(false) @map("is_primary")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  // Contacts are hard-deleted with their client (cascade); the SPEC scopes
  // soft delete to Client/Project/Deliverable only.
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  // FK index (SPEC: index FKs as tables are created, not retrofitted).
  @@index([clientId])
  @@map("contacts")
}

// --- Projects / Engagements (Phase 2) -------------------------------------

enum ServiceType {
  web_dev
  seo
  software_dev
  app_dev
  aigc
}

enum EngagementType {
  one_off
  retainer
}

enum ProjectStatus {
  active
  on_hold
  completed
  cancelled
}

model Project {
  id                  String         @id @default(cuid())
  clientId            String         @map("client_id")
  name                String
  serviceType         ServiceType    @map("service_type")
  engagementType      EngagementType @map("engagement_type")
  // Free-form string: the valid set depends on serviceType (+ engagementType
  // for aigc). Validated in the app against the stage sets in
  // src/features/projects/stages.ts rather than a DB enum, so workflows can
  // evolve without a migration.
  stage               String
  startDate           DateTime       @map("start_date")
  // Null for ongoing retainers with no fixed end.
  endDate             DateTime?      @map("end_date")
  // Only meaningful for retainer engagements; renewal automation lands in P5.
  retainerRenewalDate DateTime?      @map("retainer_renewal_date")
  status              ProjectStatus  @default(active)
  deletedAt           DateTime?      @map("deleted_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
  activities   Activity[]
  reports      ReportEntry[]

  // FK + the fields the board/list views filter on; deletedAt gates reads.
  @@index([clientId])
  @@index([serviceType])
  @@index([status])
  @@index([deletedAt])
  @@index([retainerRenewalDate])
  @@map("projects")
}

// --- Deliverables / Tasks (Phase 3) ---------------------------------------

enum DeliverableStatus {
  not_started
  in_progress
  review
  done
}

model Deliverable {
  id          String            @id @default(cuid())
  projectId   String            @map("project_id")
  title       String
  description String?
  // Assigned team member. Nullable (unassigned deliverables allowed); set null
  // rather than cascade-delete the task if the user is removed.
  ownerId     String?           @map("owner_id")
  // Nullable — not every task has a hard deadline.
  dueDate     DateTime?         @map("due_date")
  status      DeliverableStatus @default(not_started)
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // FK + fields filtered/sorted in the board and "my tasks" views.
  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("deliverables")
}

// --- Activity / Interaction Log (Phase 4) ---------------------------------

enum ActivityType {
  call
  email
  meeting
  note
}

// Append-only interaction log. No soft delete (SPEC scopes it to
// Client/Project/Deliverable); erroneous entries are hard-deleted by writers.
model Activity {
  id          String       @id @default(cuid())
  clientId    String       @map("client_id")
  // Some activity is client-level, not tied to a specific project.
  projectId   String?      @map("project_id")
  type        ActivityType
  summary     String
  // Who logged it — captured from the session, kept if the user is removed.
  createdById String?      @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Feed is per-client, newest first; composite covers that access pattern.
  @@index([clientId, createdAt])
  @@index([projectId])
  @@index([createdById])
  @@map("activities")
}

// --- Reporting (Phase 6) --------------------------------------------------

// Recurring per-period report for a project (SEO/AIGC monthly updates, etc.).
// metrics is JSON so each service type can record whatever it tracks.
model ReportEntry {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  // Reporting period, e.g. "2026-08". One entry per project per period.
  period    String
  metrics   Json     @default("{}")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // One report per project per period; index the FK for per-project listing.
  @@unique([projectId, period])
  @@index([projectId])
  @@map("report_entries")
}

// --- Audit Log (Phase 7) --------------------------------------------------

enum AuditEntityType {
  client
  project
  deliverable
}

enum AuditAction {
  create
  update
  delete
}

// Accountability trail for create/update/delete on Client, Project,
// Deliverable. Append-only; `clientId` is denormalized (the client the changed
// entity belongs to) so a per-client trail — spanning the client and its
// projects/deliverables — is a single indexed lookup.
model AuditLog {
  id          String          @id @default(cuid())
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id")
  action      AuditAction
  clientId    String?         @map("client_id")
  changedById String?         @map("changed_by")
  // { after } on create, { before } on delete, { field: {from,to} } on update.
  diff        Json
  createdAt   DateTime        @default(now()) @map("created_at")

  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  // Per-client trail, newest first; plus per-entity history and by-actor.
  @@index([clientId, createdAt])
  @@index([entityType, entityId])
  @@index([changedById])
  @@map("audit_logs")
}

// --- Sales Pipeline (Phase 8) ---------------------------------------------

// Terminal semantics of a pipeline stage. `won` promotes a prospect client to
// active and stamps closedAt; `lost` stamps closedAt; `open` is in-progress.
enum StageKind {
  open
  won
  lost
}

// A named sales pipeline (GHL-style). Deals move through its ordered stages.
// One pipeline is flagged default for views (dashboard, analytics) that show a
// single funnel.
model Pipeline {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  archived  Boolean  @default(false)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  stages PipelineStage[]
  deals  Deal[]

  @@index([archived, sortOrder])
  @@map("pipelines")
}

// An ordered stage within a pipeline. `kind` carries terminal semantics so
// win/lost behaviour survives arbitrary stage names.
model PipelineStage {
  id         String    @id @default(cuid())
  pipelineId String    @map("pipeline_id")
  name       String
  kind       StageKind @default(open)
  sortOrder  Int       @default(0) @map("sort_order")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, sortOrder])
  @@map("pipeline_stages")
}

// A sales opportunity for a client, living on one pipeline stage.
// Soft-deletable (deals are valuable history; a "lost" deal stays as history,
// deletion is for genuine mistakes only).
model Deal {
  id                String    @id @default(cuid())
  clientId          String    @map("client_id")
  pipelineId        String    @map("pipeline_id")
  stageId           String    @map("stage_id")
  title             String
  // Estimated value in whole currency units (e.g. dollars).
  value             Int       @default(0)
  ownerId           String?   @map("owner_id")
  notes             String?
  expectedCloseDate DateTime? @map("expected_close_date")
  // Set when the deal reaches a terminal stage (kind won/lost).
  closedAt          DateTime? @map("closed_at")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner    User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage    PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  // FK + fields filtered in the pipeline board; deletedAt gates reads.
  @@index([clientId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([ownerId])
  @@index([deletedAt])
  @@map("deals")
}

// --- CRM depth: tags, notes, timeline (GHL parity — G1) -------------------

// Colored label for segmenting clients (GHL-style). `color` is a key into a
// small curated tag palette rendered as soft chips (see tag display module).
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("slate")
  createdAt DateTime @default(now()) @map("created_at")

  clients ClientTag[]

  @@map("tags")
}

// Many-to-many: a client carries any number of tags.
model ClientTag {
  clientId String @map("client_id")
  tagId    String @map("tag_id")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
  @@map("client_tags")
}

// Custom field definitions (GHL-style): an admin-managed schema of extra
// attributes clients can carry. Values are stored per-client as strings and
// interpreted according to `type`.
enum CustomFieldType {
  text
  textarea
  number
  date
  boolean
  url
  select
}

model CustomFieldDef {
  id        String          @id @default(cuid())
  // Stable machine key (unique); label is the human-facing name.
  key       String          @unique
  label     String
  type      CustomFieldType @default(text)
  // Choices for `select` fields; empty for other types.
  options   String[]        @default([])
  sortOrder Int             @default(0) @map("sort_order")
  archived  Boolean         @default(false)
  createdAt DateTime        @default(now()) @map("created_at")

  values ClientCustomField[]

  @@index([archived, sortOrder])
  @@map("custom_field_defs")
}

// A single client's value for a definition. Value is serialized text
// (numbers/dates/booleans stringified) interpreted per the def's type.
model ClientCustomField {
  clientId String @map("client_id")
  fieldId  String @map("field_id")
  value    String

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  field  CustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([clientId, fieldId])
  @@index([fieldId])
  @@map("client_custom_fields")
}

// Free-form note on a client (distinct from the timestamped Activity log).
model Note {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  body        String
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("notes")
}

// --- Calendar & appointments (G3) -----------------------------------------

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

// A scheduled meeting hosted by a user, optionally tied to a client/contact.
// Times are stored as absolute instants (UTC); the UI renders in local time.
model Appointment {
  id        String            @id @default(cuid())
  title     String
  ownerId   String            @map("owner_id")
  clientId  String?           @map("client_id")
  contactId String?           @map("contact_id")
  startAt   DateTime          @map("start_at")
  endAt     DateTime          @map("end_at")
  location  String?
  notes     String?
  status    AppointmentStatus @default(scheduled)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Calendar reads are windowed by host + time; client detail lists by client.
  @@index([ownerId, startAt])
  @@index([clientId, startAt])
  @@index([startAt])
  @@map("appointments")
}

// A recurring weekly availability window for a host (used to compute bookable
// slots). Minutes are minutes-from-midnight in the host's local day.
model AvailabilityRule {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  // 0 = Sunday … 6 = Saturday.
  weekday  Int
  startMin Int    @map("start_min")
  endMin   Int    @map("end_min")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
  @@map("availability_rules")
}

// --- Automation / workflows (G4) ------------------------------------------

// Domain events that can start an automation. The `task_overdue` and
// `appointment_upcoming` triggers are time-based, fired once per entity by the
// scheduled reminder scan; the rest fire inline from the matching write.
enum AutomationTrigger {
  client_created
  contact_added
  project_created
  deal_stage_changed
  deal_won
  deal_lost
  appointment_scheduled
  appointment_upcoming
  client_tagged
  task_overdue
}

// Self-contained side effects an automation can perform (no external services).
enum AutomationActionType {
  add_tag
  create_note
  log_activity
  notify
}

// A trigger → (optional conditions) → actions rule. Org-wide; admin-managed.
model Automation {
  id         String            @id @default(cuid())
  name       String
  trigger    AutomationTrigger
  // Equality conditions on the event payload (e.g. {"stageKind":"won"});
  // null/empty = always fire. Stored as JSON.
  conditions Json?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now()) @map("created_at")

  actions AutomationAction[]
  runs    AutomationRun[]

  @@index([trigger, active])
  @@map("automations")
}

// One action within an automation, executed in sortOrder. `config` is
// action-shaped JSON (e.g. {"tag":"VIP"} / {"body":"…"} / {"type":"note","summary":"…"}).
model AutomationAction {
  id           String               @id @default(cuid())
  automationId String               @map("automation_id")
  type         AutomationActionType
  config       Json
  sortOrder    Int                  @default(0) @map("sort_order")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_actions")
}

// Audit trail of a single automation firing (for observability in the UI).
model AutomationRun {
  id           String   @id @default(cuid())
  automationId String   @map("automation_id")
  clientId     String?  @map("client_id")
  // "success" | "skipped" | "error".
  status       String
  detail       String?
  createdAt    DateTime @default(now()) @map("created_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
  @@map("automation_runs")
}

// --- File attachments (P9) ------------------------------------------------

// Metadata for a file stored in Supabase Storage. The bytes live in the
// private `attachments` bucket at `path`; this row tracks the rest.
model Attachment {
  id           String   @id @default(cuid())
  clientId     String   @map("client_id")
  name         String
  path         String
  size         Int
  contentType  String   @map("content_type")
  uploadedById String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("attachments")
}
