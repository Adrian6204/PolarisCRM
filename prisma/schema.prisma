// Polaris CRM — Prisma schema
//
// Serverless note: the app connects through DATABASE_URL (a pooled connection,
// e.g. Neon/Supabase pooler or PgBouncer). Migrations run through DIRECT_URL
// (a non-pooled connection) because DDL over a transaction pooler is unsafe.
//
// Feature models (Client, Contact, Project, ...) are added in their own phases
// per the build order. Phase 0 defines only the auth/identity models that the
// infra (NextAuth role-based sessions) needs to exist.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Identity / Auth (Phase 0) --------------------------------------------

enum Role {
  admin
  project_lead
  team_member
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // Null for SSO-only accounts; set for credentials login (hashed).
  passwordHash String?  @map("password_hash")
  role         Role     @default(team_member)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedDeliverables Deliverable[]

  @@index([role])
  @@map("users")
}

// --- Clients & Contacts (Phase 1) -----------------------------------------

enum ClientStatus {
  active
  past
  prospect
}

enum ContactRole {
  decision_maker
  technical_poc
  billing
  other
}

model Client {
  id        String       @id @default(cuid())
  name      String
  industry  String?
  website   String?
  status    ClientStatus @default(prospect)
  // Soft delete — an agency CRM where records vanish is a support headache.
  // All app-level reads must filter `deletedAt: null`; see clientService.
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  contacts Contact[]
  projects Project[]

  // status is frequently filtered in list views; deletedAt gates every read.
  @@index([status])
  @@index([deletedAt])
  @@map("clients")
}

model Contact {
  id        String      @id @default(cuid())
  clientId  String      @map("client_id")
  name      String
  email     String
  phone     String?
  role      ContactRole @default(other)
  isPrimary Boolean     @default(false) @map("is_primary")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  // Contacts are hard-deleted with their client (cascade); the SPEC scopes
  // soft delete to Client/Project/Deliverable only.
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // FK index (SPEC: index FKs as tables are created, not retrofitted).
  @@index([clientId])
  @@map("contacts")
}

// --- Projects / Engagements (Phase 2) -------------------------------------

enum ServiceType {
  web_dev
  seo
  software_dev
  app_dev
  aigc
}

enum EngagementType {
  one_off
  retainer
}

enum ProjectStatus {
  active
  on_hold
  completed
  cancelled
}

model Project {
  id       String         @id @default(cuid())
  clientId String         @map("client_id")
  name     String
  serviceType    ServiceType    @map("service_type")
  engagementType EngagementType @map("engagement_type")
  // Free-form string: the valid set depends on serviceType (+ engagementType
  // for aigc). Validated in the app against the stage sets in
  // src/features/projects/stages.ts rather than a DB enum, so workflows can
  // evolve without a migration.
  stage    String
  startDate DateTime  @map("start_date")
  // Null for ongoing retainers with no fixed end.
  endDate   DateTime? @map("end_date")
  // Only meaningful for retainer engagements; renewal automation lands in P5.
  retainerRenewalDate DateTime? @map("retainer_renewal_date")
  status   ProjectStatus @default(active)
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]

  // FK + the fields the board/list views filter on; deletedAt gates reads.
  @@index([clientId])
  @@index([serviceType])
  @@index([status])
  @@index([deletedAt])
  @@index([retainerRenewalDate])
  @@map("projects")
}

// --- Deliverables / Tasks (Phase 3) ---------------------------------------

enum DeliverableStatus {
  not_started
  in_progress
  review
  done
}

model Deliverable {
  id          String            @id @default(cuid())
  projectId   String            @map("project_id")
  title       String
  description String?
  // Assigned team member. Nullable (unassigned deliverables allowed); set null
  // rather than cascade-delete the task if the user is removed.
  ownerId     String?           @map("owner_id")
  // Nullable — not every task has a hard deadline.
  dueDate     DateTime?         @map("due_date")
  status      DeliverableStatus @default(not_started)
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // FK + fields filtered/sorted in the board and "my tasks" views.
  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("deliverables")
}
