# ---------------------------------------------------------------------------
# Polaris CRM — environment variables
# Copy this file to `.env` for local dev and fill in real values.
# All variables here are validated at boot in src/lib/env.ts — a missing or
# malformed required var fails fast instead of surfacing as a runtime error.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# DATABASE_URL is the pooled connection used by the app at runtime (serverless).
#   - Neon:     ...-pooler.<region>.aws.neon.tech/db?sslmode=require
#   - Supabase: use the pgbouncer (port 6543) connection string
#   - Local:    postgresql://polaris:polaris@localhost:5432/polaris_crm?schema=public
DATABASE_URL="postgresql://polaris:polaris@localhost:5432/polaris_crm?schema=public"
# DIRECT_URL is a non-pooled connection Prisma uses for migrations only.
# For local Postgres it is the same as DATABASE_URL; for Neon/Supabase use the
# direct (non-pooler) host.
DIRECT_URL="postgresql://polaris:polaris@localhost:5432/polaris_crm?schema=public"

# --- Auth (NextAuth / Auth.js) --------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Upstash Redis (rate limiting + caching, REST-based) -------------------
# From the Upstash console. Rate limiting degrades open if these are unset in
# local dev (see src/lib/ratelimit.ts).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Sentry (error monitoring, optional in local dev) ----------------------
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Inngest (background jobs) + Vercel Cron -------------------------------
# Local dev uses the Inngest dev server (`npx inngest-cli dev`) and needs NO
# keys. These are the production keys from the Inngest dashboard.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Shared secret Vercel Cron sends in the Authorization header so the renewal
# scan endpoint can't be triggered publicly. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error  (default: info in prod, debug in dev)
LOG_LEVEL="debug"

# --- App -------------------------------------------------------------------
# development | test | production  (set automatically by Next/Vercel)
NODE_ENV="development"
